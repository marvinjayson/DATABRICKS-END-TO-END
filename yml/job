resources:
  jobs:
    sales_etl_job:
      name: sales-etl-job
      tasks:
        - task_key: pull-datasets
          notebook_task:
            notebook_path: /Repos/jaysonheyyou@gmail.com/DATABRICKS-END-TO-END/notebook/pull_data_from_github
            source: WORKSPACE
        - task_key: master_file_and_generate_ymls
          depends_on:
            - task_key: pull-datasets
          notebook_task:
            notebook_path: /Repos/jaysonheyyou@gmail.com/DATABRICKS-END-TO-END/notebook/pull_master_file_&_create_yaml
            source: WORKSPACE
        - task_key: bronze-silver
          depends_on:
            - task_key: master_file_and_generate_ymls
          notebook_task:
            notebook_path: /Repos/jaysonheyyou@gmail.com/DATABRICKS-END-TO-END/notebook/bronze-silver
            source: WORKSPACE
        - task_key: silver-gold
          depends_on:
            - task_key: bronze-silver
          notebook_task:
            notebook_path: /Repos/jaysonheyyou@gmail.com/DATABRICKS-END-TO-END/notebook/silver-gold
            source: WORKSPACE
        - task_key: data-audit
          depends_on:
            - task_key: silver-gold
          notebook_task:
            notebook_path: /Repos/jaysonheyyou@gmail.com/DATABRICKS-END-TO-END/notebook/data-audit
            source: WORKSPACE
        - task_key: data-quality
          depends_on:
            - task_key: silver-gold
          notebook_task:
            notebook_path: /Repos/jaysonheyyou@gmail.com/DATABRICKS-END-TO-END/notebook/data-quality-check
            source: WORKSPACE
      queue:
        enabled: true
      performance_target: PERFORMANCE_OPTIMIZED